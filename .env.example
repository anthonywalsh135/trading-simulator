#copy this file to .env and fill in the real values.
#.env is gitignored and must never be committed.

#the key flask signs the session with. generate one with:
#  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-your-own-do-not-use-this-value

#the gmail account that sends the one time codes.
#GMAIL_APP_PASSWORD is a 16 character google app password, not the password for
#the account itself. make one at https://myaccount.google.com/apppasswords
#(two step verification has to be switched on for the account first).
GMAIL_USER=your-otp-sender@gmail.com
GMAIL_APP_PASSWORD=your16charapppass

#development settings
FLASK_DEBUG=1
